# =============================================================================
# MomCare API - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_VERSION=v1
API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Primary database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=momcare_db
DB_USER=momcare_admin
DB_PASSWORD=your_secure_password_here

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# SSL for production
DB_SSL=false
DB_SSL_CA=

# Read replica (optional, for scaling)
DB_READ_REPLICA_HOST=
DB_READ_REPLICA_PORT=

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Session and cache TTL (in seconds)
SESSION_TTL=86400
CACHE_TTL=3600

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_for_security
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_key_also_minimum_64_characters
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# OAuth Configuration
# -----------------------------------------------------------------------------
# Apple Sign-In
APPLE_CLIENT_ID=com.yourcompany.momcare
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY_PATH=./keys/apple_auth_key.p8

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# S3 Buckets
S3_BUCKET_UPLOADS=momcare-uploads
S3_BUCKET_MEDIA=momcare-media
S3_PRESIGNED_URL_EXPIRES=3600

# CloudFront CDN (optional)
CLOUDFRONT_DOMAIN=

# -----------------------------------------------------------------------------
# Stripe Payment Configuration
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Subscription Price IDs
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_monthly_id
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_yearly_id

# -----------------------------------------------------------------------------
# OpenAI Configuration (for AI features)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_VISION_MODEL=gpt-4-vision-preview

# -----------------------------------------------------------------------------
# USDA FoodData Central API
# -----------------------------------------------------------------------------
USDA_API_KEY=your_usda_api_key

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Encryption key for sensitive data (AES-256)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_256_bit_encryption_key_in_hex_format

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_FAILED=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,momcare://

# Trusted proxies (for production behind load balancer)
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=combined
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=14

# -----------------------------------------------------------------------------
# Email Configuration (for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@momcare.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=MomCare <noreply@momcare.com>

# -----------------------------------------------------------------------------
# Push Notifications (Apple Push Notification Service)
# -----------------------------------------------------------------------------
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_KEY_PATH=./keys/apns_auth_key.p8
APNS_BUNDLE_ID=com.yourcompany.momcare
APNS_PRODUCTION=false

# -----------------------------------------------------------------------------
# Telehealth Integration (optional)
# -----------------------------------------------------------------------------
TELEHEALTH_PROVIDER_API_KEY=
TELEHEALTH_PROVIDER_URL=

# -----------------------------------------------------------------------------
# Monitoring & Analytics
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
DATADOG_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AI_FOOD_RECOGNITION=true
FEATURE_TELEHEALTH=true
FEATURE_COMMUNITY_CHAT=true
FEATURE_PARTNER_DASHBOARD=true

# -----------------------------------------------------------------------------
# Medical Compliance
# -----------------------------------------------------------------------------
# HIPAA audit logging
HIPAA_AUDIT_ENABLED=true
HIPAA_AUDIT_RETENTION_DAYS=2555

# Data retention (in days)
DATA_RETENTION_ACTIVE_USER=365
DATA_RETENTION_DELETED_USER=90
